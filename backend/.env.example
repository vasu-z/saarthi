# SAARTHI Backend Environment Configuration

# Core Application Settings
PROJECT_NAME="SAARTHI API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# CORS Configuration
# Provide as a JSON list (e.g. ["http://localhost:3000"]) or comma-separated origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Credentials flag: Set to true only if CORS_ORIGINS explicitly lists allowed domains (no "*")
CORS_ALLOW_CREDENTIALS=False

# Google Gemini / Gemma API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
# Recommended production model for low-latency vision: "gemini-3.5-flash-lite"
# Open-weights model: "gemma-4-26b-a4b-it" (Note: hosted Google AI Studio container may experience upstream 504 timeouts on heavy vision prompts)
GEMINI_MODEL="gemini-3.5-flash-lite"
# Set to True for local development without active Gemini API keys
ENABLE_AI_MOCK=False

# ElevenLabs Official Text-to-Speech API Configuration
# Get your API key from ElevenLabs (https://elevenlabs.io/)
# Keep this key strictly on the backend; never expose to mobile clients.
ELEVENLABS_API_KEY=""
# Default voice: "21m00Tcm4TlvDq8ikWAM" (Rachel) or custom multilingual voice
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
# Recommended model for high-clarity multilingual English/Hindi: "eleven_multilingual_v2"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

